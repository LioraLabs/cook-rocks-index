# Cookfile for cook-rocks-index — the rocks.usecook.com source repo.
#
# GitHub (LioraLabs/cook-rocks-index) is canonical; Cloudflare Workers +
# Static Assets reads from it and serves rocks.usecook.com. The old
# Gitea-canonical + orphan-snapshot mirror flow is retired.
#
# Quick reference:
#   cook publish     - push main to GitHub (triggers the Cloudflare deploy)
#   cook manifest    - regenerate manifest-5.4 from rockspecs in this dir
#   cook smoke       - verify rocks.usecook.com serves the live manifest

chore publish
    git push github main

# Rebuild manifest-5.4 from every .rockspec / .src.rock in this directory.
# Requires luarocks installed locally.
chore manifest
    luarocks-admin make-manifest .

# Smoke test the live site. Verifies the manifest is reachable and the
# Cloudflare deploy is still healthy.
chore smoke
    curl -sI https://rocks.usecook.com/manifest-5.4
    echo
    curl -sSL https://rocks.usecook.com/manifest-5.4
